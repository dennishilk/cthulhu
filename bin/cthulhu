#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$BIN_DIR/.." && pwd)"

# shellcheck source=lib/utils.sh
source "$ROOT_DIR/lib/utils.sh"
# shellcheck source=lib/save_system.sh
source "$ROOT_DIR/lib/save_system.sh"
# shellcheck source=lib/save_core.sh
source "$ROOT_DIR/lib/save_core.sh"
# shellcheck source=lib/restore.sh
source "$ROOT_DIR/lib/restore.sh"

usage() {
  cat <<'USAGE'
cthulhu - configuration archive and restore framework

Usage:
  cthulhu save system
  cthulhu save core
  cthulhu restore system <distro> <YYYY-MM-DD>
  cthulhu restore core <component|all>
  cthulhu list systems
  cthulhu list core
USAGE
}

list_systems() {
  log "INFO" "Listing system snapshots"
  find "$ROOT_DIR/systems" -mindepth 2 -maxdepth 2 -type d | sed "s|$ROOT_DIR/systems/||" | sort
}

list_core() {
  log "INFO" "Listing archived core components"
  find "$ROOT_DIR/core" -mindepth 1 -maxdepth 3 \( -type d -o -type f \) | sed "s|$ROOT_DIR/core/||" | sort
}

main() {
  [ "$#" -ge 1 ] || { usage; exit 1; }

  case "$1" in
    save)
      [ "$#" -eq 2 ] || die "Invalid save usage"
      case "$2" in
        system) save_system ;;
        core) save_core ;;
        *) die "Unknown save target: $2" ;;
      esac
      ;;
    restore)
      [ "$#" -ge 3 ] || die "Invalid restore usage"
      case "$2" in
        system)
          [ "$#" -eq 4 ] || die "Usage: cthulhu restore system <distro> <YYYY-MM-DD>"
          restore_system "$3" "$4"
          ;;
        core)
          [ "$#" -eq 4 ] || die "Usage: cthulhu restore core <component|all>"
          restore_core "$3"
          ;;
        *) die "Unknown restore target: $2" ;;
      esac
      ;;
    list)
      [ "$#" -eq 2 ] || die "Invalid list usage"
      case "$2" in
        systems) list_systems ;;
        core) list_core ;;
        *) die "Unknown list target: $2" ;;
      esac
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      usage
      die "Unknown command: $1"
      ;;
  esac
}

main "$@"
