{
    "layer": "top",
    "position": "top",
    "height": 30,
    "output": "DP-1",
    "modules-left": [],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio"],
    "clock": {
        "format": "{:%H:%M:%S}",
        "interval": 1,
        "on-click": "gsimplecal"
    },
    "network": {
        "format-ethernet": " {bandwidthDownBytes}",
        "format-wifi": "  {bandwidthDownBytes}",
        "format-disconnected": "⚠ Disconnected",
        "interval": 1
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "cpu": {
        "format": " {usage}%",
        "interval": 2
    },
    "temperature": {
        "critical-threshold": 80,
        "format": " {temperatureC}°C",
        "interval": 2
    },
    "memory": {
        "format": " {used:0.1f}GB / {total:0.1f}GB",
        "interval": 3
    }
}

